android_app {
    name: "XiaomiEuicc",
    certificate: "platform",
    srcs: ["src/**/*.kt"],
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
        "SettingsLib",
        "qcrilhook-xiaomi",
    ],
    required: [
        "hidden-api-whitelist-com.xiaomi.settings.xml",
        "privapp_whitelist_com.xiaomi.settings.xml",
        "EuiccGoogle",
    ],
}

android_app_import {
    name: "EuiccGoogle",
    owner: "xiaomi",
    apk: "proprietary/product/priv-app/EuiccGoogle/EuiccGoogle.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    product_specific: true,
    required: [
        "default-permissions-euicc.xml",
        "privapp-permissions-euiccgoogle.xml",
    ],
}

dex_import {
    name: "mirilhook",
    owner: "xiaomi",
    jars: [
        "proprietary/system_ext/framework/mirilhook.jar",
    ],
    system_ext_specific: true,
}

dex_import {
    name: "qcrilhook-xiaomi",
    owner: "xiaomi",
    jars: [
        "proprietary/system_ext/framework/qcrilhook-xiaomi.jar",
    ],
    system_ext_specific: true,
}

prebuilt_etc {
    name: "default-permissions-euicc.xml",
    filename: "default-permissions-euicc.xml",
    src: "permissions/default-permissions-euicc.xml",
    sub_dir: "default-permissions",
    product_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-euiccgoogle.xml",
    filename: "privapp-permissions-euiccgoogle.xml",
    src: "permissions/privapp-permissions-euiccgoogle.xml",
    sub_dir: "permissions",
    product_specific: true,
}

prebuilt_etc {
    name: "hidden-api-whitelist-com.xiaomi.settings.xml",
    filename: "hidden-api-whitelist-com.xiaomi.settings.xml",
    src: "permissions/hidden-api-whitelist-com.xiaomi.settings.xml",
    sub_dir: "sysconfig",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp_whitelist_com.xiaomi.settings.xml",
    src: "permissions/privapp_whitelist_com.xiaomi.settings.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
